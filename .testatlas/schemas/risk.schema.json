{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testatlas.dev/schemas/v2/risk.schema.json",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^RISK-[0-9]+$" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "description": { "type": "string" },
    "affected_domains": { "type": "array", "items": { "type": "string" } },
    "affected_flows": { "type": "array", "items": { "type": "string" } },
    "mitigation": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "mitigated", "accepted", "closed"] }
  },
  "required": ["id", "severity", "description", "status"],
  "additionalProperties": false
}
