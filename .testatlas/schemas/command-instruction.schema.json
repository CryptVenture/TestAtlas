{
  "$id": "https://testatlas.dev/schemas/v1/command-instruction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestAtlas Command Instruction",
  "description": "Schema for the YAML frontmatter of every .testatlas/commands/*.md file (PRD §11, §38; CMD-02, CMD-04, CMD-05).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "version",
    "description",
    "capabilities",
    "produces",
    "consumes",
    "lifecycle",
    "boundary"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "description": "Kebab-case command name; must equal the filename minus '.md'."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver triple (no pre-release in v1)."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["browser", "shell", "web-fetch", "MCP", "file-write"]
      },
      "description": "Adapter capabilities this command USES (declare full set; not minimal)."
    },
    "produces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "consumes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lifecycle": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "03_execution_status.md",
          "09_artifact_index.md",
          "10_command_log.md",
          "11_workspace_manifest.json",
          "history/run_log.md"
        ]
      },
      "description": "All five lifecycle artifacts updated after every command (PRD §40)."
    },
    "boundary": {
      "type": "string",
      "minLength": 20,
      "description": "What this command MUST NOT do (PRD §6.5; mirrors bootstrap §4)."
    }
  }
}
