{
  "$id": "https://testatlas.dev/schemas/v1/domain.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestAtlas Domain",
  "description": "Schema for domains/<slug>/domain.json (PRD §15).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "displayName",
    "status",
    "confidence",
    "purpose",
    "primaryUserGoals",
    "personas",
    "entryPoints",
    "routes",
    "apis",
    "components",
    "entities",
    "flows",
    "dependencies",
    "issues",
    "evidence",
    "openQuestions",
    "lastUpdatedAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/domainId" },
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "status": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/domainStatus" },
    "confidence": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/lowMedHighConfidence" },
    "purpose": { "type": "string", "minLength": 1 },
    "primaryUserGoals": { "type": "array", "items": { "type": "string" } },
    "personas": { "type": "array", "items": { "type": "string" } },
    "entryPoints": { "type": "array", "items": { "type": "string" } },
    "routes": {
      "type": "array",
      "items": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/pageId" }
    },
    "apis": {
      "type": "array",
      "items": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/apiId" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/componentId" }
    },
    "entities": { "type": "array", "items": { "type": "string" } },
    "flows": {
      "type": "array",
      "items": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/flowId" }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "issues": {
      "type": "array",
      "items": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/issueId" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/evidenceId" }
    },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "lastUpdatedAt": { "$ref": "https://testatlas.dev/schemas/v1/vocabulary.schema.json#/$defs/isoTimestamp" }
  }
}
