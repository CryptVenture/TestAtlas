{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testatlas.dev/schemas/v2/claim.schema.json",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^CLAIM-[0-9]+$" },
    "session_id": { "type": "string" },
    "speaker": { "type": "string" },
    "type": { "type": "string", "enum": ["observed", "inferred", "hypothesized", "disputed", "invalidated", "accepted"] },
    "claim": { "type": "string" },
    "confidence": { "type": "string", "enum": ["confirmed", "strong_suspect", "needs_validation"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "related_domains": { "type": "array", "items": { "type": "string" } },
    "related_flows": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "disputed", "needs_validation"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "session_id", "speaker", "type", "claim", "confidence", "status", "created_at"],
  "additionalProperties": false
}
