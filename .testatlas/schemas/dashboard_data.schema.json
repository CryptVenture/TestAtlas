{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testatlas.dev/schemas/v2/dashboard_data.schema.json",
  "title": "TestAtlas V2 Dashboard Data Export",
  "description": "Pre-aggregated JSON shape consumed by external dashboards. PRD §16. Generated by `generate-dashboard-data.js` from brain state. Mirrors PRD §23 example brain summary plus issue and council aggregates.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "pattern": "^2\\.0\\.0$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1 },
    "quality_summary": {
      "type": "object",
      "properties": {
        "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "domains_tested": { "type": "integer", "minimum": 0 },
        "domains_total": { "type": "integer", "minimum": 0 },
        "open_critical": { "type": "integer", "minimum": 0 },
        "open_high": { "type": "integer", "minimum": 0 }
      },
      "required": ["overall_score", "domains_total"],
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "open_issues": { "type": "integer", "minimum": 0 },
          "drift_status": {
            "type": "string",
            "enum": ["fresh", "possibly_stale", "stale_requires_review", "unknown"]
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    },
    "issues_by_severity": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "enhancement": { "type": "integer", "minimum": 0 }
      },
      "required": ["critical", "high", "medium", "low"],
      "additionalProperties": false
    },
    "council_activity": {
      "type": "object",
      "properties": {
        "sessions_total": { "type": "integer", "minimum": 0 },
        "sessions_last_7_days": { "type": "integer", "minimum": 0 },
        "open_decisions": { "type": "integer", "minimum": 0 }
      },
      "required": ["sessions_total"],
      "additionalProperties": false
    },
    "drift": {
      "type": "object",
      "properties": {
        "stale_domains": { "type": "array", "items": { "type": "string" } },
        "drift_records_7_days": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "generated_at", "project", "quality_summary"],
  "additionalProperties": false
}
