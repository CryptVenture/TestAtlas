{
  "$id": "https://testatlas.dev/schemas/v1/vocabulary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestAtlas Shared Vocabularies",
  "description": "Single source of truth for severity, confidence, status enums, and ID patterns referenced by every TestAtlas schema. PRD §28 + §32.",
  "$defs": {
    "capability": {
      "type": "string",
      "enum": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "description": "Locked capability vocabulary. Hosts declare which capabilities they support; commands declare which they require; bootstrap.md documents per-host invocation. Plan 09-02 extended this to 6 entries by adding subagent-spawn. Phase 14 Wave 5 (V2) added council-orchestration, brain-sync, and persona-context for the multi-agent council + brain layer."
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "enhancement"]
    },
    "confidence": {
      "type": "string",
      "enum": ["confirmed", "strong-suspect", "needs-validation"]
    },
    "issueStatus": {
      "type": "string",
      "enum": [
        "new",
        "triaged",
        "in_progress",
        "blocked",
        "fixed_pending_retest",
        "retested",
        "closed",
        "wont_fix"
      ]
    },
    "issueType": {
      "type": "string",
      "enum": [
        "functional",
        "regression",
        "ux",
        "copy",
        "accessibility",
        "performance",
        "reliability",
        "state",
        "validation",
        "integration",
        "data",
        "documentation",
        "observability",
        "testability",
        "setup"
      ]
    },
    "flowStatus": {
      "type": "string",
      "enum": [
        "draft",
        "mapped",
        "ready_to_test",
        "tested",
        "blocked",
        "fixed_pending_retest",
        "retested"
      ]
    },
    "domainStatus": {
      "type": "string",
      "enum": ["mapped", "partial", "needs_review", "tested", "blocked"]
    },
    "lowMedHighConfidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "screenshot",
        "video",
        "log",
        "trace",
        "network",
        "console",
        "api",
        "db",
        "file",
        "accessibility",
        "performance"
      ]
    },
    "testType": {
      "type": "string",
      "enum": [
        "smoke",
        "user-flow",
        "exploratory",
        "regression",
        "negative",
        "state",
        "accessibility",
        "performance",
        "integration",
        "setup"
      ]
    },
    "testStatus": {
      "type": "string",
      "enum": ["draft", "ready", "executed", "blocked", "deprecated"]
    },
    "manifestStatus": {
      "type": "string",
      "enum": [
        "initialized",
        "exploring",
        "planning",
        "testing",
        "blocked",
        "reporting",
        "ready_for_retest"
      ]
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kebabSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "issueId": {
      "type": "string",
      "pattern": "^ISSUE-\\d{3,}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EVIDENCE-\\d{3,}(-[a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "domainId": {
      "type": "string",
      "pattern": "^domain-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "flowId": {
      "type": "string",
      "pattern": "^FLOW-[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "testId": {
      "type": "string",
      "pattern": "^TEST-[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "pageId": {
      "type": "string",
      "pattern": "^PAGE-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "apiId": {
      "type": "string",
      "pattern": "^API-(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)-[a-z0-9-]+$"
    },
    "cliId": {
      "type": "string",
      "pattern": "^CLI-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^COMPONENT-[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^JOB-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "integrationId": {
      "type": "string",
      "pattern": "^INTEGRATION-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "personaId": {
      "type": "string",
      "pattern": "^PERSONA-[a-z0-9]+(-[a-z0-9]+)*$"
    },

    "claim_type": {
      "type": "string",
      "enum": ["observed", "inferred", "hypothesized", "disputed", "invalidated", "accepted"],
      "description": "V2 — TestAtlas Brain claim type. PRD §7.10. Identifies the epistemic status of a claim extracted from a council transcript."
    },
    "council_type": {
      "type": "string",
      "enum": [
        "domain-review",
        "flow-deepdive",
        "release-readiness",
        "issue-triage",
        "risk-assessment",
        "regression-strategy",
        "exploration-planning",
        "dispute-resolution"
      ],
      "description": "V2 — Council session category. PRD §7.8 / §9.3. Determines default participants, prompt scaffold, and consolidation expectations."
    },
    "drift_status": {
      "type": "string",
      "enum": ["fresh", "possibly_stale", "stale_requires_review", "unknown"],
      "description": "V2 — Drift status for a flow/domain/coverage record. PRD §7.16. 'fresh' = no relevant code changes since last verify; 'possibly_stale' = touched files in dependency cone; 'stale_requires_review' = behavior-defining files changed; 'unknown' = no baseline."
    },
    "persona_type": {
      "type": "string",
      "enum": ["system", "generated", "project"],
      "description": "V2 — Persona origin. PRD §6.2 (system: shipped with TestAtlas), §6.3 (generated: synthesized from product context), §7.7 (project: hand-authored in repo)."
    },
    "message_type": {
      "type": "string",
      "enum": [
        "finding",
        "critique",
        "rebuttal",
        "vote",
        "consolidation",
        "question",
        "evidence_request"
      ],
      "description": "V2 — Transcript message kind. PRD §7.10 / §25. Drives consolidation logic and orchestrator turn-taking."
    },
    "disagreement_type": {
      "type": "string",
      "enum": [
        "factual",
        "interpretation",
        "priority",
        "scope",
        "evidence_sufficiency",
        "risk_assessment"
      ],
      "description": "V2 — Disagreement classification. PRD §12.5. Used when two personas hold conflicting positions; informs resolution strategy (more evidence, vote, escalate, defer)."
    },
    "vote_value": {
      "type": "string",
      "enum": ["strong_yes", "yes", "abstain", "no", "strong_no"],
      "description": "V2 — Council vote value. PRD §12.6. Five-point scale; consolidation requires majority + no strong_no for binding decisions."
    }
  }
}
