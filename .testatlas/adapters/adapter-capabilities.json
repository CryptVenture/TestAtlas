{
  "$schema": "../schemas/adapter-capabilities.schema.json",
  "version": "2.0.9",
  "adapters": [
    {
      "name": "claude-code",
      "displayName": "Claude Code (canonical)",
      "outputDir": ".testatlas/adapters/claude-code",
      "outputPattern": ".claude/commands/atlas-{command}.md",
      "globalOutputPattern": ".claude/commands/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file"
    },
    {
      "name": "generic",
      "displayName": "Generic Prompt Adapter",
      "outputDir": ".testatlas/adapters/generic",
      "outputPattern": "prompts/atlas-{command}.md",
      "globalOutputPattern": ".config/testatlas/prompts/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Generic prompts live under ~/.config/testatlas/prompts/. Paste any one into your agent of choice."
    },
    {
      "name": "opencode",
      "displayName": "OpenCode",
      "outputDir": ".testatlas/adapters/opencode",
      "outputPattern": ".opencode/commands/atlas-{command}.md",
      "globalOutputPattern": ".config/opencode/command/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file"
    },
    {
      "name": "kilocode",
      "displayName": "KiloCode",
      "outputDir": ".testatlas/adapters/kilocode",
      "outputPattern": ".kilocode/workflows/atlas-{command}.md",
      "globalOutputPattern": ".kilocode/workflows/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file"
    },
    {
      "name": "cursor",
      "displayName": "Cursor",
      "outputDir": ".testatlas/adapters/cursor",
      "outputPattern": ".cursor/rules/atlas-{command}.mdc",
      "globalOutputPattern": ".cursor/rules/atlas-{command}.mdc",
      "fileExtension": ".mdc",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file"
    },
    {
      "name": "aider",
      "displayName": "Aider",
      "outputDir": ".testatlas/adapters/aider",
      "outputPattern": "CONVENTIONS.md",
      "globalOutputPattern": ".config/aider/CONVENTIONS.md",
      "fileExtension": ".md",
      "capabilities": [
        "shell",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "concatenated-conventions",
      "globalNotes": "Aider doesn't auto-discover global conventions. Add `aider --read ~/.config/aider/CONVENTIONS.md` to your shell alias or `~/.aider.conf.yml`."
    },
    {
      "name": "mcp",
      "displayName": "MCP-capable Agent",
      "outputDir": ".testatlas/adapters/mcp",
      "outputPattern": "mcp-server-manifest.json",
      "globalOutputPattern": ".config/testatlas/mcp-server-manifest.json",
      "fileExtension": ".json",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "mcp-server",
      "globalNotes": "MCP clients are configured per-app (Claude Desktop, Cursor MCP, etc.). Point them at `node ~/.config/testatlas/scripts/mcp-server.js` after `--global` install."
    },
    {
      "name": "codex",
      "displayName": "OpenAI Codex CLI",
      "outputDir": ".testatlas/adapters/codex",
      "outputPattern": ".codex/prompts/atlas-{command}.md",
      "globalOutputPattern": ".codex/prompts/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Codex auto-discovers prompts at ~/.codex/prompts/ (set $CODEX_HOME to override). Files invoke as /prompts:atlas-<name>."
    },
    {
      "name": "gemini-cli",
      "displayName": "Google Gemini CLI",
      "outputDir": ".testatlas/adapters/gemini-cli",
      "outputPattern": ".gemini/commands/atlas-{command}.toml",
      "globalOutputPattern": ".gemini/commands/atlas-{command}.toml",
      "fileExtension": ".toml",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Gemini CLI auto-discovers TOML commands at ~/.gemini/commands/. Run /commands reload (or restart) after install. Files invoke as /atlas-<name>."
    },
    {
      "name": "cline",
      "displayName": "Cline",
      "outputDir": ".testatlas/adapters/cline",
      "outputPattern": ".clinerules/workflows/atlas-{command}.md",
      "globalOutputPattern": ".config/cline/workflows/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Cline workflows are slash-invoked WITH the .md extension (e.g. `/atlas-init.md`). Workflows live in `.clinerules/workflows/` per project; the global config dir is OS-dependent so we use `~/.config/cline/workflows/` as a portable default — set `cline.workflowsPath` in your IDE settings to point there."
    },
    {
      "name": "windsurf",
      "displayName": "Windsurf / Cascade",
      "outputDir": ".testatlas/adapters/windsurf",
      "outputPattern": ".windsurf/workflows/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Windsurf has no documented global workflow path; project-local install is the only supported mode."
    },
    {
      "name": "kiro",
      "displayName": "Kiro",
      "outputDir": ".testatlas/adapters/kiro",
      "outputPattern": ".kiro/skills/atlas-{command}.md",
      "globalOutputPattern": ".kiro/skills/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Kiro skills are flat-file `~/.kiro/skills/atlas-<name>.md`. Slash-invoke as /atlas-<name>."
    },
    {
      "name": "continue-dev",
      "displayName": "Continue.dev",
      "outputDir": ".testatlas/adapters/continue-dev",
      "outputPattern": ".continue/prompts/atlas-{command}.prompt.md",
      "globalOutputPattern": ".continue/prompts/atlas-{command}.prompt.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Continue auto-discovers `~/.continue/prompts/`. Slash-invoke as /atlas-<name> in Chat / Plan / Agent modes."
    },
    {
      "name": "github-copilot",
      "displayName": "GitHub Copilot",
      "outputDir": ".testatlas/adapters/github-copilot",
      "outputPattern": ".github/prompts/atlas-{command}.prompt.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "GitHub Copilot has no documented global filesystem path for prompts; --global skips. For machine-wide steering, edit `github.copilot.chat.codeGeneration.instructions` in VS Code user settings manually."
    },
    {
      "name": "sourcegraph-amp",
      "displayName": "Sourcegraph Amp",
      "outputDir": ".testatlas/adapters/sourcegraph-amp",
      "outputPattern": ".agents/commands/atlas-{command}.md",
      "globalOutputPattern": ".agents/commands/atlas-{command}.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "subagent-spawn",
        "council-orchestration",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "per-command-file",
      "globalNotes": "Amp walks AGENTS.md from cwd up to $HOME; per-command files in `~/.agents/commands/` are the practical global path."
    },
    {
      "name": "roo-code",
      "displayName": "Roo Code",
      "outputDir": ".testatlas/adapters/roo-code",
      "outputPattern": ".roo/rules/atlas.md",
      "globalOutputPattern": ".roo/rules/atlas.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "concatenated-conventions",
      "globalNotes": "Roo concatenates all `.roo/rules/*.md` into the system prompt alphabetically. The single `atlas.md` file lists all atlas commands (V1 + V2 categorized) in collapsed form (one short H2 each, ≤7 lines body)."
    },
    {
      "name": "zed",
      "displayName": "Zed",
      "outputDir": ".testatlas/adapters/zed",
      "outputPattern": ".rules",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "concatenated-conventions",
      "globalNotes": "Zed has no file-installable global rules path; --global skips. For machine-wide rules, use Zed's UI Rules Library."
    },
    {
      "name": "amazon-q",
      "displayName": "Amazon Q Developer",
      "outputDir": ".testatlas/adapters/amazon-q",
      "outputPattern": ".amazonq/rules/atlas.md",
      "globalOutputPattern": ".aws/amazonq/prompts/atlas.md",
      "fileExtension": ".md",
      "capabilities": [
        "browser",
        "shell",
        "web-fetch",
        "MCP",
        "file-write",
        "brain-sync",
        "persona-context"
      ],
      "renderStrategy": "concatenated-conventions",
      "globalNotes": "Amazon Q project rules live at `.amazonq/rules/`; user prompt library at `~/.aws/amazonq/prompts/`. Q auto-applies rules; not slash-invokable."
    }
  ]
}
