# Dependencies
node_modules/
.pnpm-store/

# Build output (none expected — no build step — but defensive)
dist/
!test/dist/
build/
coverage/

# IDE / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# TestAtlas runtime state (workspaces and update backups should never be in the suite repo itself)
.testatlas.backup-*/
.testatlas.staging-*/
.testatlas/.update-cache.json
.testatlas/.install-manifest.json
_testatlas/
# … except inside examples/, where each example ships a checked-in workspace
# (Plan 08-01: examples/<name>/_testatlas/ is the deterministic-replay output
# tree and is the source-of-truth the regenerate-example.js drift-check
# compares against in CI).
!examples/*/_testatlas/
!examples/*/_testatlas/**
# Plan 08-03: examples/monorepo ships per-app workspaces too — whitelist
# `examples/monorepo/apps/<app>/_testatlas/` and `examples/monorepo/packages/<pkg>/_testatlas/`
# (any nested `_testatlas/` under examples/<name>/).
!examples/*/**/_testatlas/
!examples/*/**/_testatlas/**

# Env (suite uses none, but defensive)
.env
.env.local
.env.*.local

# OBD / planning tooling local state
.openbrain/
.openbrain/cache/
.planning/
.serena
prd

CLAUDE.md
AGENTS.md
tmp-test-v2-migration/
tmp/
.claude
